{
  "name": "nfl_manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cap:check": "tsx scripts/cap-math-check.ts",
    "contract:check": "tsx scripts/contract-acceptance-check.ts",
    "test:e2e": "playwright test",
    "test:trade-offers": "node --import tsx --test src/lib/trade-*.test.ts src/features/trades/trade-*.test.ts src/server/logic/trade-offer-generator.test.ts",
    "sync:nfl-data": "tsx src/scripts/sync-nfl-data.ts",
    "data:sync": "tsx src/scripts/sync-nfl-data.ts",
    "content:sync": "tsx src/scripts/sync-team-content.ts",
    "auth:migrate": "tsx scripts/migrate-auth.ts",
    "trivia:seed": "tsx scripts/seed-trivia.ts",
    "test:auth": "node --import tsx --test src/server/auth/*.test.ts",
    "test:user": "node --import tsx --test src/server/user/*.test.ts",
    "test:trivia": "node --import tsx --test src/features/trivia/*.test.ts",
    "test:rewards": "node --import tsx --test src/features/rewards/*.test.ts",
    "test:story-engine": "node --import tsx --test src/features/story-engine/*.test.ts",
    "source:watch": "node --import tsx scripts/source-watcher.ts",
    "source:demo": "node --import tsx scripts/story-engine-demo.ts",
    "surfaces:demo": "node --import tsx scripts/story-surfaces-demo.ts",
    "mobile:start": "npm --prefix apps/mobile start",
    "mobile:ios": "npm --prefix apps/mobile run ios",
    "avatar:audit": "python3 tools/avatar-studio/scripts/audit_environment.py",
    "avatar:test": "python3 tools/avatar-studio/scripts/render_test.py --presenter main-presenter",
    "sync:contracts": "tsx src/scripts/sync-contracts.ts",
    "sync:league": "tsx src/scripts/sync-nfl-data.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.0",
    "@tanstack/react-table": "^8.20.5",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "jose": "^6.2.10",
    "lucide-react": "^0.474.0",
    "next": "14.2.5",
    "postgres": "^3.4.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.5.4",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.19.37",
    "@types/react": "^18.2.65",
    "@types/react-dom": "^18.2.22",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "postcss": "^8.4.38",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
