{
  "name": "@down-distance/content-engine-poc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/local.mjs dev",
    "db:migrate": "node scripts/local.mjs migrate",
    "build": "node scripts/local.mjs build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "format:check": "prettier --check src test scripts measurements *.json *.md",
    "qualify": "node --import tsx scripts/project.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@types/node": "26.6.5",
    "miniflare": "5.20261012.1-beta",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "wrangler": "4.151.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
