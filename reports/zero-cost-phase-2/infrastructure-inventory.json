  "schedules": {
    ".github/workflows/draft-prospect-sync.yml": "name: 2027 Draft Prospect Sync\n\non:\n  workflow_dispatch:\n  schedule:\n    - cron: '15 8 * * *'\n\njobs:\n  sync:\n    runs-on: ubuntu-latest\n    timeout-minutes: 10\n    permissions:\n      contents: write\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with:\n          node-version: '20'\n          cache: npm\n      - run: npm ci\n      - run: npm run sync:draft-prospects\n      - name: Commit a validated reference-data version\n        run: |\n          if [[ -n \"$(git status --porcelain src/server/data/draft-prospects-2027.json src/server/data/draft-prospects-2027.meta.json)\" ]]; then\n            git config user.name \"github-actions[bot]\"\n            git config user.email \"41898282+github-actions[bot]@users.noreply.github.com\"\n            git add src/server/data/draft-prospects-2027.json src/server/data/draft-prospects-2027.meta.json\n            git commit -m \"chore: refresh 2027 draft prospects\"\n            git push\n          fi\n",
    ".github/workflows/nfl-data-sync.yml": "name: NFL Data Sync\n\non:\n  workflow_dispatch:\n  schedule:\n    - cron: '0 3 * * *'\n\njobs:\n  sync:\n    permissions:\n      contents: write\n    runs-on: ubuntu-latest\n    timeout-minutes: 10\n    steps:\n      - name: Checkout\n        uses: actions/checkout@v4\n\n      - name: Setup Node\n        uses: actions/setup-node@v4\n        with:\n          node-version: '20'\n          cache: npm\n\n      - name: Install dependencies\n        run: npm ci\n\n      - name: Sync NFL data\n        run: npm run sync:nfl-data\n\n      - name: Commit updated data (if changed)\n        run: |\n          if [[ -n \"$(git status --porcelain src/server/data/nfl-data.json)\" ]]; then\n            git config user.name \"github-actions[bot]\"\n            git config user.email \"41898282+github-actions[bot]@users.noreply.github.com\"\n            git add src/server/data/nfl-data.json\n            git commit -m \"chore: daily nfl data refresh\"\n            git push\n          fi\n",
    ".github/workflows/search-index.yml": "name: Search index reconciliation\n\non:\n  workflow_dispatch:\n    inputs:\n      full:\n        description: Run a full reindex\n        type: boolean\n        default: false\n  schedule:\n    - cron: '30 4 * * *'\n\njobs:\n  index:\n    runs-on: ubuntu-latest\n    timeout-minutes: 10\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with:\n          node-version: '20'\n          cache: npm\n      - run: npm ci\n      - name: Reconcile search index\n        env:\n          DATABASE_URL: ${{ secrets.DATABASE_URL }}\n          SEARCH_EMBEDDING_BASE_URL: ${{ secrets.SEARCH_EMBEDDING_BASE_URL }}\n          SEARCH_EMBEDDING_ENABLED: 'false'\n          SEARCH_EMBEDDING_MODEL: BAAI/bge-small-en-v1.5\n        run: npm run search:index -- ${{ inputs.full && '--full' || '' }}\n",
    ".github/workflows/three-and-out-daily.yml": "name: Three & Out daily briefing\n\non:\n  schedule:\n    # Evaluate IANA-local delivery times all day; generate missing daily briefings on demand.\n    - cron: '*/5 * * * *'\n  workflow_dispatch:\n    inputs:\n      action:\n        description: Generate, deliver, or check deployment readiness\n        required: true\n        default: generate\n        type: choice\n        options:\n          - generate\n          - deliver\n          - check\n\nconcurrency:\n  group: three-and-out-daily\n  cancel-in-progress: false\n\njobs:\n  run:\n    runs-on: ubuntu-latest\n    timeout-minutes: 10\n    steps:\n      - name: Generate or deliver daily briefings\n        env:\n          BASE_URL: ${{ secrets.CONTENT_AUTOMATION_BASE_URL }}\n          AUTOMATION_SECRET: ${{ secrets.CONTENT_AUTOMATION_SECRET }}\n          MANUAL_ACTION: ${{ inputs.action }}\n          EVENT_NAME: ${{ github.event_name }}\n          SCHEDULE: ${{ github.event.schedule }}\n        run: |\n          set -euo pipefail\n\n          if [ -z \"$BASE_URL\" ]; then\n            echo \"::error::CONTENT_AUTOMATION_BASE_URL is not configured in repository Actions secrets.\"\n            exit 1\n          fi\n          if [ -z \"$AUTOMATION_SECRET\" ]; then\n            echo \"::error::CONTENT_AUTOMATION_SECRET is not configured in repository Actions secrets.\"\n            exit 1\n          fi\n          case \"$BASE_URL\" in\n            http://*|https://*) ;;\n            *)\n              echo \"::error::CONTENT_AUTOMATION_BASE_URL must be a complete http:// or https:// URL.\"\n              exit 1\n              ;;\n          esac\n\n          if [ \"$EVENT_NAME\" = \"workflow_dispatch\" ]; then\n            action=\"$MANUAL_ACTION\"\n          else\n            action=\"deliver\"\n          fi\n          curl --fail-with-body --retry 2 --request POST \\\n            --header \"Authorization: Bearer $AUTOMATION_SECRET\" \\\n            \"${BASE_URL%/}/api/automation/three-and-out?action=$action\"\n"
  }
}
