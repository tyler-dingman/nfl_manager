  code: 'ERR_ASSERTION'
  name: 'AssertionError'
  expected:
  actual: |-
    .page {
      background: #f8f6f2;
      color: #00172b;
      min-height: calc(100vh - 95px);
      padding: 32px max(24px, calc((100% - 1480px) / 2)) 72px;
    }
    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 24px;
      margin-bottom: 32px;
    }
    .eyebrow {
      color: var(--team-primary-text);
      text-transform: uppercase;
      font-size: 18px;
      font-weight: 800;
      letter-spacing: 0.07em;
    }
    .header h1 {
      font-size: 48px;
      font-weight: 850;
      letter-spacing: -0.04em;
      line-height: 1.15;
      margin: 6px 0;
    }
    .subtitle {
      color: #59708b;
      font-size: 21px;
    }
    .actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 16px;
    }
    .button,
    .teamSelect {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      min-height: 52px;
      padding: 12px 20px;
      border: 1px solid #dce3eb;
      background: white;
      border-radius: 12px;
      font-weight: 700;
      font-size: 16px;
      color: #00172b;
    }
    .button:hover {
      background: color-mix(in srgb, var(--team-primary-fill) 8%, white);
      border-color: var(--team-primary-fill);
    }
    .button:focus-visible,
    .answer:focus-visible,
    .teamSelect:focus-within {
      outline: 3px solid var(--team-primary-text);
      outline-offset: 3px;
    }
    .button:disabled {
      opacity: 0.6;
      cursor: wait;
    }
    .teamSelect {
      padding: 10px 14px;
      min-width: 0;
    }
    .teamSelect img {
      width: 34px;
      height: 34px;
      object-fit: contain;
    }
    .teamSelect select {
      background: transparent;
      max-width: 230px;
      min-width: 0;
      font-weight: 700;
      cursor: pointer;
    }
    .layout {
      display: grid;
      grid-template-columns: minmax(0, 1.85fr) minmax(330px, 1fr);
      gap: 24px;
      align-items: start;
      grid-template-areas: 'question sidebar' 'stats sidebar' 'activity sidebar';
    }
    .card {
      background: #fff;
      border: 1px solid #e0e6ed;
      border-radius: 14px;
      min-width: 0;
      padding: 22px;
    }
    .questionCard {
      grid-area: question;
      padding: 0;
      overflow: hidden;
    }
    .category {
      display: flex;
      align-items: center;
      gap: 20px;
      background: var(--team-primary-fill);
      color: var(--team-primary-foreground);
      clip-path: polygon(0 0, 100% 0, 94% 100%, 0 100%);
      width: 83%;
      min-height: 68px;
      padding: 16px 32px 16px 26px;
      font-size: 15px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.16em;
    }
    .category img {
      height: 34px;
      width: 48px;
      object-fit: contain;
    }
    .questionBody {
      padding: 24px 22px 0;
    }
    .progressRow {
      display: flex;
      align-items: center;
      gap: 22px;
      padding-bottom: 24px;
      border-bottom: 1px solid #e5eaf0;
      font-size: 16px;
    }
    .progressRow strong {
      white-space: nowrap;
    }
    .progress {
      display: flex;
      flex: 1;
      gap: 3px;
      min-width: 0;
    }
    .progress span {
      height: 11px;
      flex: 1;
      border-radius: 8px;
      background: #d8dde4;
    }
    .progress span[data-active='true'] {
      background: var(--team-primary-fill);
    }
    .timer {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 22px;
      font-weight: 800;
      color: var(--team-primary-text);
      font-variant-numeric: tabular-nums;
    }
    .question {
      font-size: 32px;
      line-height: 1.16;
      font-weight: 800;
      letter-spacing: -0.035em;
      margin: 26px 0 36px;
      overflow-wrap: anywhere;
    }
    .answers {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }
    .answer {
      display: flex;
      align-items: center;
      gap: 20px;
      min-height: 88px;
      padding: 16px;
      border: 1px solid #d3dfeb;
      background: #fff;
      border-radius: 12px;
      text-align: left;
      font-size: 20px;
      line-height: 1.35;
      overflow-wrap: anywhere;
    }
    .answer > svg {
      flex-shrink: 0;
      margin-left: auto;
    }
    .answer:hover:enabled,
    .answer[data-state='selected'] {
      border-color: var(--team-primary-text);
      background: color-mix(in srgb, var(--team-primary-fill) 8%, white);
    }
    .answer[data-state='correct'] {
      border-color: #189c42;
      background: #eaf9ee;
      color: #12782f;
    }
    .answer[data-state='incorrect'] {
      border-color: var(--team-primary-text);
      background: #fff0f3;
      color: #ba0029;
    }
    .letter {
      display: grid;
      place-items: center;
      flex-shrink: 0;
      width: 50px;
      height: 50px;
      border: 1px solid #d8e1ec;
      border-radius: 15px;
      font-size: 26px;
      font-weight: 800;
    }
    .feedback {
      min-height: 32px;
      padding: 7px 0;
      font-size: 14px;
      font-weight: 600;
      color: #64748b;
    }
    .feedback [data-correct='true'] {
      color: #15803d;
    }
    .feedback [data-correct='false'] {
      color: #be123c;
    }
    .stats {
      grid-area: stats;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
    }
    .stat {
      display: flex;
      align-items: center;
      gap: 14px;
      background: white;
      border: 1px solid #e0e6ed;
      padding: 16px;
      border-radius: 12px;
      min-width: 0;
    }
    .stat > span {
      display: grid;
      place-items: center;
      width: 62px;
      height: 62px;
      flex-shrink: 0;
      border: 1px solid #e7ebf0;
      border-radius: 17px;
    }
    .stat svg {
      width: 37px;
      height: 37px;
    }
    .stat:first-child svg {
      color: #f3ad00;
    }
    .stat p {
      color: #59708b;
      font-size: 17px;
    }
    .stat strong {
      display: block;
      font-size: 26px;
      font-weight: 800;
      line-height: 1.25;
    }
    .leaderboard {
      grid-area: leaderboard;
    }
    .activity {
      grid-area: activity;
    }
    .info {
      grid-area: info;
    }
    .cardHeading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      border-bottom: 1px solid #e5eaf0;
      padding-bottom: 18px;
    }
    .cardHeading h2 {
      display: flex;
      align-items: center;
      gap: 14px;
      font-size: 27px;
      font-weight: 800;
      letter-spacing: -0.035em;
      line-height: 1.2;
    }
    .cardHeading svg {
      width: 28px;
      height: 28px;
      color: var(--team-primary-text);
      flex-shrink: 0;
    }
    .cardHeading > span {
      color: #59708b;
      font-size: 14px;
      white-space: nowrap;
    }
    .standings {
      padding: 4px 0;
    }
    .standings li {
      display: grid;
      grid-template-columns: 34px 34px minmax(0, 1fr) auto;
      align-items: center;
      gap: 12px;
      min-height: 54px;
      padding: 8px;
      border-bottom: 1px solid #e5eaf0;
      font-size: 16px;
    }
    .standings li[data-current='true'] {
      background: color-mix(in srgb, var(--team-primary-fill) 10%, white);
      border-radius: 12px;
      border-color: transparent;
    }
    .rank {
      display: grid;
      place-items: center;
      width: 32px;
      height: 32px;
      font-weight: 700;
    }
    .rank[data-rank='1'],
    .rank[data-rank='2'],
    .rank[data-rank='3'] {
      background: #f6b500;
      color: white;
      border-radius: 50%;
    }
    .rank[data-rank='2'] {
      background: #9da5ae;
    }
    .rank[data-rank='3'] {
      background: #c46a22;
    }
    .avatar {
      display: grid;
      place-items: center;
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: #425364;
      color: #fff;
      font-size: 13px;
      font-weight: 600;
    }
    .playerName {
      overflow-wrap: anywhere;
    }
    .fullWidth {
      width: 100%;
      margin-top: 12px;
    }
    .events li {
      display: flex;
      align-items: center;
      gap: 24px;
      padding: 18px 6px;
      border-bottom: 1px solid #e5eaf0;
    }
    .events li:last-child {
      border: 0;
      padding-bottom: 0;
    }
    .events p {
      color: #59708b;
      line-height: 1.55;
    }
    .events strong {
      color: #00172b;
    }
    .outcome {
      display: grid;
      place-items: center;
      flex-shrink: 0;
      width: 46px;
      height: 46px;
      border-radius: 50%;
      background: #ed0033;
      color: white;
    }
    .outcome[data-correct='true'] {
      background: #1bad3c;
    }
    .info li {
      display: flex;
      align-items: center;
      gap: 20px;
      padding: 15px 6px;
      border-bottom: 1px solid #e5eaf0;
    }
    .info li:last-child {
      border: 0;
      padding-bottom: 0;
    }
    .info li svg {
      width: 24px;
      flex-shrink: 0;
    }
    .empty {
      color: #59708b;
      padding: 24px 0;
    }
    .notice {
      padding: 16px;
      margin-bottom: 20px;
      background: #fff1df;
      border-radius: 12px;
      display: flex;
      gap: 16px;
      align-items: center;
      flex-wrap: wrap;
    }
    .loading {
      padding: 60px 24px;
      text-align: center;
      font-size: 22px;
    }
    .results {
      padding: 40px 24px;
      text-align: center;
    }
    .results > svg {
      margin: 0 auto 20px;
      color: #f3ad00;
    }
    .results h2 {
      font-size: 34px;
      font-weight: 800;
    }
    .finalScore {
      font-size: 48px;
      font-weight: 800;
    }
    .results .actions {
      justify-content: center;
      margin-top: 28px;
    }
    .primary,
    .primary:hover {
      background: var(--team-primary-fill);
      color: var(--team-primary-foreground);
    }
    @media (min-width: 1500px) {
      .page {
        padding-left: max(40px, calc((100% - 1564px) / 2));
        padding-right: max(40px, calc((100% - 1564px) / 2));
      }
    }
    @media (max-width: 1200px) {
      .header {
        align-items: flex-start;
      }
      .header h1 {
        font-size: 42px;
      }
      .actions {
        gap: 10px;
      }
      .layout {
        grid-template-columns: minmax(0, 1.7fr) minmax(300px, 1fr);
        gap: 20px;
      }
      .card {
        padding: 18px;
      }
      .questionCard {
        padding: 0;
      }
      .stat {
        padding: 12px;
        gap: 8px;
      }
      .stat > span {
        width: 40px;
        height: 48px;
      }
      .stat svg {
        width: 28px;
      }
      .stat p {
        font-size: 14px;
      }
      .stat strong {
        font-size: 22px;
      }
      .cardHeading h2 {
        font-size: 24px;
      }
      .answer {
        font-size: 18px;
        gap: 12px;
      }
      .letter {
        width: 40px;
        height: 44px;
      }
      .progressRow {
        gap: 12px;
      }
    }
    @media (max-width: 1000px) {
      .header {
        flex-direction: column;
      }
      .layout {
        grid-template-columns: 1fr;
        grid-template-areas: 'question' 'stats' 'activity';
      }
      .standings .extraPlayer {
        display: none;
      }
      .header h1 {
        font-size: 42px;
      }
      .stat > span {
        width: 54px;
      }
      .stat p {
        font-size: 16px;
      }
      .stat strong {
        font-size: 26px;
      }
    }
    @media (max-width: 600px) {
      .page {
        padding: 24px 16px 48px;
      }
      .header {
        gap: 20px;
        margin-bottom: 24px;
      }
      .header h1 {
        font-size: 36px;
      }
      .subtitle {
        font-size: 17px;
      }
      .header .actions {
        width: 100%;
        flex-direction: column;
        align-items: stretch;
      }
      .teamSelect {
        justify-content: flex-start;
      }
      .teamSelect select {
        flex: 1;
        max-width: none;
      }
      .questionBody {
        padding: 18px 16px 0;
      }
      .category {
        width: 94%;
        min-height: 52px;
        padding: 12px 26px 12px 16px;
        font-size: 11px;
        gap: 12px;
      }
      .category img {
        width: 32px;
        height: 26px;
      }
      .progressRow {
        flex-wrap: wrap;
        justify-content: space-between;
        padding-bottom: 18px;
      }
      .progress {
        flex-basis: 100%;
        order: 3;
      }
      .timer {
        font-size: 20px;
      }
      .question {
        font-size: 27px;
        margin: 22px 0 26px;
      }
      .answers {
        grid-template-columns: 1fr;
        gap: 12px;
      }
      .answer {
        min-height: 76px;
        padding: 12px;
        font-size: 18px;
      }
      .letter {
        width: 44px;
        height: 46px;
      }
      .stats {
        gap: 8px;
      }
      .stat {
        flex-direction: column;
        align-items: flex-start;
        padding: 12px 10px;
        gap: 8px;
      }
      .stat > span {
        border: 0;
        width: 30px;
        height: 30px;
      }
      .stat p {
        font-size: 12px;
      }
      .stat strong {
        font-size: 21px;
      }
      .cardHeading h2 {
        font-size: 25px;
        gap: 10px;
      }
      .cardHeading > span {
        font-size: 12px;
      }
      .standings li {
        gap: 8px;
        font-size: 15px;
      }
      .events li {
        gap: 16px;
      }
      .feedback {
        min-height: 42px;
      }
      .results .actions {
        flex-direction: column;
      }
      .results .button {
        width: 100%;
      }
    }

    .sidebar {
      grid-area: sidebar;
      display: flex;
      flex-direction: column;
      gap: 24px;
      min-width: 0;
    }
    @media (max-width: 1000px) {
      .sidebar {
        display: contents;
      }
    }

