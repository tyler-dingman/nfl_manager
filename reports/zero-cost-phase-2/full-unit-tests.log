        let timer: number | undefined;
        if (isNegative && !wasNegativeRef.current) {
          pushAlert(buildCapCrisisAlert());
        }
        wasNegativeRef.current = isNegative;
        return () => {
          if (timer) {
            window.clearTimeout(timer);
          }
        };
      }, [capSpace, pushAlert, saveId]);

