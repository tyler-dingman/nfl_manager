# Reviewed staging template only. Supply secrets through Wrangler secrets, never this file.
APP_DATA_BACKEND=d1
APP_RUNTIME=cloudflare
INFRASTRUCTURE_COST_POLICY=zero-cost
APP_CACHE_VERSION=reviewed-release-id
APP_PASSWORD_ENABLED=false
EDITORIAL_ADMIN_USER_IDS=
APP_PUBLIC_CACHE_ENABLED=false
APP_ODDS_ENABLED=false
APP_ODDS_PROCESSING_ENABLED=false
APP_EDITORIAL_EMAIL_ENABLED=false
APP_MAIL_ENABLED=false
APP_MAINTENANCE_ENABLED=false
SEARCH_ANSWER_PROVIDER=disabled
PRELAUNCH_MODE=true
AUTH_BASE_URL=https://reviewed-staging-host.invalid
# Required secrets, deliberately unset:
# AUTH_JWT_SECRET
# APP_MAIL_ENCRYPTION_KEY
# APP_MAIL_FROM
# RESEND_API_KEY
# SPORTSGAMEODDS_API_KEY
# Existing OAuth/provider/automation secrets for the routes actually enabled.
# Workers AI binding requires separate hosted quota and quality qualification.
# DATABASE_URL remains solely in the preserved PostgreSQL rollback environment.
