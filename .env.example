# Canonical Down & Distance authentication database (PostgreSQL).
DATABASE_URL=postgresql://user:password@host:5432/down_distance

# Private deployed testing gate. Use a separate random signing secret in hosted environments.
PRELAUNCH_MODE=false
PRELAUNCH_PASSWORD=
PRELAUNCH_SESSION_SECRET=

# Generate with: openssl rand -base64 48
AUTH_JWT_SECRET=
AUTH_BASE_URL=http://localhost:3000

# Comma-separated internal user IDs allowed to use enabled admin APIs.
ADMIN_USER_IDS=

# Sign in with Apple
APPLE_CLIENT_ID=
APPLE_IOS_CLIENT_ID=com.downdistance.mobile
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM value may use literal \n sequences in one environment-variable line.
APPLE_PRIVATE_KEY=

# Google OpenID Connect
GOOGLE_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook Login
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Notification providers are server-only. Keep credentials out of source control.
PUSH_PROVIDER=EXPO
EXPO_ACCESS_TOKEN=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
SMS_PROVIDER=
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=

# Content AI is deterministic by default in production. Ollama must remain local during evaluation.
CONTENT_AI_PROVIDER=deterministic
MAX_NEW_AI_STORIES_PER_TEAM_PER_DAY=10
OPENAI_API_KEY=
OPENAI_CONTENT_MODEL=
# Legacy aliases retained for existing local environments.
CONTENT_SUMMARIZER=
OLLAMA_CONTENT_MODEL=
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Permanent global source dispatcher. Leave false until the Cloudflare Worker,
# production migration, and protected endpoint have been manually verified.
CONTENT_AUTOMATION_GLOBAL_ENABLED=true
CONTENT_AUTOMATION_SECRET=
# Temporary overlap during rotation; remove after all schedulers use the new secret.
CONTENT_AUTOMATION_PREVIOUS_SECRET=
CONTENT_AUTOMATION_MAX_GENERATED_PER_RUN=10
CONTENT_AUTOMATION_MAX_GENERATED_PER_DAY=320

# Server-only YouTube Data API v3 key used by Film Room metadata requests.
YOUTUBE_API_KEY=

# Stripe cards use test mode; express wallets, tax, and carrier providers remain demos.
COMMERCE_PAYMENT_PROVIDER=demo
COMMERCE_SHIPPING_PROVIDER=manual
COMMERCE_TAX_PROVIDER=demo
COMMERCE_DEMO_TAX_RATE=0.0825
STRIPE_MODE=test
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
COMMERCE_STANDARD_SHIPPING_CENTS=699
COMMERCE_EXPRESS_SHIPPING_CENTS=1299

# Self-hosted search services. No proprietary AI API is used.
# Structured facts always use data adapters without model inference.
# Deterministic mode produces a source-backed briefing outline; Ollama adds validated synthesis.
# Set to ollama only when a local Ollama service is available.
SEARCH_ANSWER_PROVIDER=deterministic
SEARCH_EMBEDDING_ENABLED=false
SEARCH_EMBEDDING_BASE_URL=http://127.0.0.1:7997
SEARCH_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SEARCH_LLM_BASE_URL=http://127.0.0.1:11434
SEARCH_LLM_MODEL=qwen2.5:3b-instruct
WHISPER_BASE_URL=http://127.0.0.1:8000
WHISPER_MODEL=small.en

# Team content monitoring. Observer mode suppresses all real push delivery.
OBSERVER_MODE=false
SOURCE_TIER_A_SECONDS=180
SOURCE_TIER_B_SECONDS=600
SOURCE_TIER_C_SECONDS=1200
MONITOR_INDEX_ONLY_MAX=44
MONITOR_FEED_ONLY_MAX=64
MONITOR_CANDIDATE_NOTIFICATION_MIN=65
MONITOR_PUSH_NOTIFICATION_MIN=80
MONITOR_BREAKING_NOTIFICATION_MIN=90
X_BEARER_TOKEN=
X_INGESTOR_ENABLED=
YOUTUBE_WEBSUB_CALLBACK_URL=
YOUTUBE_WEBSUB_ENABLED=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_INGESTOR_ENABLED=
PUBLIC_PAGE_INGESTION_ENABLED=
SPORTSGAMEODDS_API_KEY=

# Browser Web Push (generate once: npx web-push generate-vapid-keys)
# Keep the private key server-only; use the same keys across deployments.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:notifications@example.com
# Lab Score uses the opportunity model by default; the former version env switch is retired.
# Local tools: npm run parlay-lab:roles; npm run parlay-lab:snaps -- --seasons=2026
# Compare: npm run parlay-lab:score-audit -- --output=/tmp/parlay-backtest.json
# Current slate: add --slate. Per-offer evidence: add --debug.

# Unabated staged migration: server-only; credentials never belong in NEXT_PUBLIC_*.
# Current production provider remains SportsGameOdds until the live coverage audit passes.
UNABATED_API_KEY=
UNABATED_PARTNER_CODE=
UNABATED_API_BASE_URL=https://data.unabated.com
# Selecting unabated blocks legacy ingestion; Unabated writes remain gated pending validation.
ODDS_PROVIDER=sportsgameodds
ENABLE_UNABATED_INGESTION=false
ENABLE_FANDUEL_BETSLIP=false

# Controlled non-production FanDuel transfer test. Never enabled in production by this implementation.
FANDUEL_TEST_USER_IDS=
UNABATED_MAX_GENERATIONS_PER_USER_DAY=50
UNABATED_MAX_GENERATIONS_GLOBAL_DAY=50
UNABATED_MAX_CONCURRENT_GENERATIONS=3

# Controlled sportsbook transfer: same test-user allowlist and shared Unabated budget
ENABLE_DRAFTKINGS_BETSLIP=false
# Maximum proposed threshold differences; invalid values disable substitutions for that market
TRANSFER_MAX_DIFF_PASSING_YARDS=10
TRANSFER_MAX_DIFF_RUSHING_YARDS=7.5
TRANSFER_MAX_DIFF_RECEIVING_YARDS=7.5
TRANSFER_MAX_DIFF_RECEPTIONS=1
TRANSFER_MIN_SUBSTITUTE_ODDS=-800

# Local allowlisted pilots only; keep disabled until manually verified.
ENABLE_BETMGM_BETSLIP=false
ENABLE_CAESARS_BETSLIP=false
