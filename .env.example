# Canonical Down & Distance authentication database (PostgreSQL).
DATABASE_URL=postgresql://user:password@host:5432/down_distance

# Private deployed testing gate. Use a separate random signing secret in hosted environments.
PRELAUNCH_MODE=false
PRELAUNCH_PASSWORD=
PRELAUNCH_SESSION_SECRET=

# Generate with: openssl rand -base64 48
AUTH_JWT_SECRET=
AUTH_BASE_URL=http://localhost:3000

# Comma-separated internal user IDs allowed to use enabled admin APIs.
ADMIN_USER_IDS=

# Sign in with Apple
APPLE_CLIENT_ID=
APPLE_IOS_CLIENT_ID=com.downdistance.mobile
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM value may use literal \n sequences in one environment-variable line.
APPLE_PRIVATE_KEY=

# Google OpenID Connect
GOOGLE_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook Login
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Notification providers are server-only. Keep credentials out of source control.
PUSH_PROVIDER=EXPO
EXPO_ACCESS_TOKEN=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
SMS_PROVIDER=
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=

# Existing content engine configuration
OPENAI_API_KEY=
OPENAI_CONTENT_MODEL=
CONTENT_SUMMARIZER=
OLLAMA_CONTENT_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Server-only YouTube Data API v3 key used by Film Room metadata requests.
YOUTUBE_API_KEY=

# Three & Out segmented browser-narration POC. Set false to hide the audio card.
NEXT_PUBLIC_THREE_OUT_AUDIO_ENABLED=true
THREE_OUT_TTS_PROVIDER=chatterbox
CHATTERBOX_BASE_URL=http://127.0.0.1:8100
CHATTERBOX_SERVICE_TOKEN=
CHATTERBOX_VOICE_VERSION=chiefs-three-out-v2
CHATTERBOX_REFERENCE_VOICE=apps/web/private/tts/final_chiefs_three_and_out.wav

# Stripe cards use test mode; express wallets, tax, and carrier providers remain demos.
COMMERCE_PAYMENT_PROVIDER=demo
COMMERCE_SHIPPING_PROVIDER=manual
COMMERCE_TAX_PROVIDER=demo
COMMERCE_DEMO_TAX_RATE=0.0825
STRIPE_MODE=test
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
COMMERCE_STANDARD_SHIPPING_CENTS=699
COMMERCE_EXPRESS_SHIPPING_CENTS=1299

# Self-hosted search services. No proprietary AI API is used.
SEARCH_EMBEDDING_BASE_URL=http://127.0.0.1:7997
SEARCH_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SEARCH_LLM_BASE_URL=http://127.0.0.1:11434
SEARCH_LLM_MODEL=qwen2.5:3b-instruct
WHISPER_BASE_URL=http://127.0.0.1:8000
WHISPER_MODEL=small.en

# Team content monitoring. Observer mode suppresses all real push delivery.
OBSERVER_MODE=false
SOURCE_TIER_A_SECONDS=180
SOURCE_TIER_B_SECONDS=600
SOURCE_TIER_C_SECONDS=1200
MONITOR_INDEX_ONLY_MAX=44
MONITOR_FEED_ONLY_MAX=64
MONITOR_CANDIDATE_NOTIFICATION_MIN=65
MONITOR_PUSH_NOTIFICATION_MIN=80
MONITOR_BREAKING_NOTIFICATION_MIN=90
X_BEARER_TOKEN=
X_INGESTOR_ENABLED=
YOUTUBE_WEBSUB_CALLBACK_URL=
YOUTUBE_WEBSUB_ENABLED=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_INGESTOR_ENABLED=
PUBLIC_PAGE_INGESTION_ENABLED=
