{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "firebase": {
      "developmentClient": false,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "firebase",
        "EXPO_PUBLIC_API_BASE_URL": "https://www.downdistance.com",
        "EXPO_PUBLIC_USE_FIXTURES": "false",
        "ANDROID_VERSION_CODE": "1790631228"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "demo": {
      "developmentClient": false,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "demo",
        "EXPO_PUBLIC_USE_FIXTURES": "false"
      }
    }
  }
}
